   <dc:title>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Square monster face emotion. Abstract game avatar</rdf:li>
    </rdf:Alt>
   </dc:title>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Set of square monster face for player avatar in game. Cartoon emotion expression on stickers in vector. Funny alien character clipart collection with happy, angry and upset mood, cry, eyes with tears</rdf:li>
    </rdf:Alt>
   </dc:description>
